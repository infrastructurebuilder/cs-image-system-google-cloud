# Terraform configuration for GCE instances generated by TofuGceInstanceBuilder (tofu-gce)
terraform {
    required_providers {
        google = {
            source = "hashicorp/google"
        }
    }
    
    backend "gcs" {
    }
}
provider "google" {
    project = "csis-sandbox"
    region = "us-east1"
    zone = "us-east1-b"
    alias = "tofu_gce"
}
variable "gce_test_image" {
    type = string
    default = ""
}
variable "enrollment_token" {
    type = string
    default = ""
    description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
    sensitive = true
}
data "terraform_remote_state" "gcp_pd" {
    backend = "gcs"
    
    config = {
        bucket = "csis-sandbox-tfstate"
        prefix = "statefiles/csia/gcp_pd"
    }
}
data "terraform_remote_state" "gcp_gcs" {
    backend = "gcs"
    
    config = {
        bucket = "csis-sandbox-tfstate"
        prefix = "statefiles/csia/gcp_gcs"
    }
}